{
  "permissions": {
    "allow": [
      "mcp__github__pull_request_read",
      "Bash(bundle exec rspec *)",
      "mcp__Notion__notion-fetch",
      "Bash(git fetch *)",
      "mcp__Notion__notion-query-data-sources",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_triggers",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__update_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__delete_trigger",
      "mcp__github__list_pull_requests",
      "mcp__Notion__notion-search",
      "mcp__Notion__notion-create-pages",
      "mcp__Notion__notion-update-page",
      "mcp__Notion__notion-update-data-source",
      "mcp__Notion__notion-create-database",
      "mcp__Notion__notion-create-comment",
      "mcp__Notion__notion-move-pages",
      "mcp__Notion__notion-duplicate-page",
      "mcp__Notion__notion-create-attachment",
      "mcp__Notion__notion-create-file-upload",
      "mcp__Notion__notion-create-folder",
      "mcp__Notion__notion-update-folder",
      "mcp__Notion__notion-create-view",
      "mcp__Notion__notion-update-view"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/caveman-activate.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/caveman-mode-tracker.js\""
          }
        ]
      }
    ]
  }
}
