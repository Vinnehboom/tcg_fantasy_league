<%= render layout: "devise/shared/form_container" do %>

  <h2><%= t('.sign_up') %></h2>

<%=  simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

    <%= f.input :email, autofocus: true,
                input_html: { autocomplete: "email" } %>

    <%= f.input :username %>
    <%= f.input :country, collection: ISO3166::Country.codes.sort_by { |code| ISO3166::Country.new(code).common_name },
                label_method: ->(code) { ISO3166::Country.new(code).common_name },
                value_method: :itself %>
    <%= f.input :date_of_birth, as: :date, start_year: Date.current.year - 100, end_year: Date.current.year %>
    <%= f.input :password, as: :password, input_html: { autocomplete: "new-password" } %>
    <% if @minimum_password_length %>
      <em><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em>
    <% end %>
    <br />
    <%= f.input :password_confirmation, as: :password, input_html: { autocomplete: "new-password" }  %>

    <div class="d-flex align-items-end flex-column">
      <div class="form-actions">
        <%= f.submit t('devise.registrations.sign_up'), class: 'btn btn-success' %>
      </div>
      <div class="text-end mt-2">
        <%= render "devise/shared/links" %>
      </div>
    </div>
<% end %>



<% end %>