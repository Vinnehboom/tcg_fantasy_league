<div class="player-information">
  <h1><%= t('.title') %></h1>

  <p><%= t('.draft_notice') %></p>
  <p><%= t('.intro') %></p>

  <section>
    <h2><%= t('.controller_heading') %></h2>
    <p><%= t('.controller_name') %></p>
    <p><%= t('.controller_address') %></p>
  </section>

  <section>
    <h2><%= t('.contact_heading') %></h2>
    <p><%= t('.contact_address') %></p>
  </section>

  <section>
    <h2><%= t('.data_heading') %></h2>
    <p><%= t('.data_body') %></p>
  </section>

  <section>
    <h2><%= t('.source_heading') %></h2>
    <p><%= t('.source_body') %></p>
  </section>

  <section>
    <h2><%= t('.purpose_heading') %></h2>
    <p><%= t('.purpose_body') %></p>
  </section>

  <section>
    <h2><%= t('.lawful_basis_heading') %></h2>
    <p><%= t('.lawful_basis_body') %></p>
  </section>

  <section>
    <h2><%= t('.retention_heading') %></h2>
    <p><%= t('.retention_body') %></p>
    <p><%= t('.retention_import_logs_body') %></p>
  </section>

  <section>
    <h2><%= t('.recipients_heading') %></h2>
    <p><%= t('.recipients_body') %></p>
  </section>

  <section>
    <h2><%= t('.transfers_heading') %></h2>
    <p><%= t('.transfers_body') %></p>
  </section>

  <section>
    <h2><%= t('.rights_heading') %></h2>
    <p><%= t('.rights_body') %></p>
    <p><%= t('.rights_portability') %></p>
  </section>

  <section>
    <h2><%= t('.object_heading') %></h2>
    <p><%= t('.object_route') %> <%= link_to t('.object_form_link'), new_data_subject_request_path %>.</p>
    <p><%= t('.object_outcome') %></p>
    <p><%= t('.object_queue') %></p>
  </section>

  <section>
    <h2><%= t('.complaints_heading') %></h2>
    <p><%= t('.complaints_ico') %></p>
    <p><%= t('.complaints_dpo') %></p>
  </section>
</div>
