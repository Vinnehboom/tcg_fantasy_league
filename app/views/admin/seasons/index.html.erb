<h2 class="mb-3"><%= t('.title', game: @game.name) %></h2>

<% if @seasons.any? %>
  <table class="table table-dark table-striped rounded-2 overflow-hidden">
    <thead>
      <tr>
        <th><%= t('activerecord.attributes.season.label') %></th>
        <th><%= t('activerecord.attributes.season.start_date') %></th>
        <th><%= t('activerecord.attributes.season.end_date') %></th>
      </tr>
    </thead>
    <tbody>
      <% @seasons.each do |season| %>
        <tr>
          <td><%= season.label %></td>
          <td><%= l(season.start_date) %></td>
          <td><%= season.end_date ? l(season.end_date) : t('.open') %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('.no_seasons') %></p>
<% end %>
