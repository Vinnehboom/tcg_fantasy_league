<h2 class="mb-3"><%= t('.title', game: @game.name) %></h2>

<% if policy(:season).new? %>
  <div class="d-flex p-2 m-2 w-100 justify-content-end">
    <%= link_to t('.add'), new_admin_game_season_path(@game), class: 'btn btn-success' %>
  </div>
<% end %>

<% if @seasons.any? %>
  <table class="table table-dark table-striped rounded-2 overflow-hidden">
    <thead>
      <tr>
        <th><%= t('activerecord.attributes.season.label') %></th>
        <th><%= t('activerecord.attributes.season.start_date') %></th>
        <th><%= t('activerecord.attributes.season.end_date') %></th>
        <th><%= t('views.tables.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @seasons.each do |season| %>
        <tr>
          <td><%= season.label %></td>
          <td><%= l(season.start_date) %></td>
          <td><%= season.end_date ? l(season.end_date) : t('.open') %></td>
          <td>
            <% if policy(season).edit? %>
              <%= link_to t('views.tables.edit'), edit_admin_game_season_path(@game, season), class: 'text-light text-opacity-75' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('.no_seasons') %></p>
<% end %>
