<h2 class="mb-3"><%= @tournament.name %></h2>

<table class="table table-primary w-50">
  <tr>
    <td class="fw-bold"><%= t('activerecord.attributes.tournament.external_id') %></td>
    <td><%= @tournament.external_id %></td>
  </tr>
  <tr>
    <td class="fw-bold"><%= t('activerecord.attributes.tournament.starting_date') %></td>
    <td><%= l(@tournament.starting_date) %></td>
  </tr>
  <tr>
    <td class="fw-bold"><%= t('activerecord.attributes.tournament.results_source_id') %></td>
    <td><%= @tournament.results_source_id %></td>
  </tr>
</table>

<%= form_with url: admin_tournament_path(@tournament), method: :patch, class: 'd-flex gap-2 align-items-center' do |f| %>
  <%= f.text_field :results_source_id, value: @tournament.results_source_id,
                    class: 'form-control form-control-sm', style: 'width: 20rem;',
                    placeholder: t('.results_source_id_placeholder') %>
  <%= f.submit t('.set_results_source_id'), class: 'btn btn-sm btn-primary' %>
<% end %>

<div class="mt-3">
  <% if @tournament.results_source_id.present? %>
    <div class="d-flex gap-2 align-items-center"
         data-controller="results-import-trigger"
         data-results-import-trigger-url-value="<%= admin_api_tournament_results_path(@tournament) %>"
         data-results-import-trigger-success-text-value="<%= t('.trigger_success') %>"
         data-results-import-trigger-failure-text-value="<%= t('.trigger_failure') %>">
      <button type="button" class="btn btn-sm btn-primary"
              data-action="results-import-trigger#trigger">
        <%= t('.trigger_results_import') %>
      </button>
      <span data-results-import-trigger-target="status"></span>
    </div>
  <% else %>
    <p class="mb-0 text-muted"><%= t('.results_source_id_required') %></p>
  <% end %>
</div>
