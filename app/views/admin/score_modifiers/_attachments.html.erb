<h3 class="mt-4"><%= t('.attachments') %></h3>

<% if player_season_modifiers.any? %>
  <table class="table table-dark table-striped rounded-2 overflow-hidden">
    <thead>
      <tr>
        <th><%= t('.player') %></th>
        <th><%= t('.season') %></th>
        <th><%= t('views.tables.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% player_season_modifiers.each do |player_season_modifier| %>
        <tr>
          <td><%= player_season_modifier.player_season.player.name %></td>
          <td><%= player_season_modifier.player_season.season.label %></td>
          <td>
            <div data-controller="score-modifier-attachment"
                 data-score-modifier-attachment-url-value="<%= admin_score_modifier_player_season_modifier_path(@score_modifier, player_season_modifier) %>"
                 data-score-modifier-attachment-confirm-value="<%= t('.confirm_detach') %>"
                 data-score-modifier-attachment-generic-error-value="<%= t('admin.score_modifiers.player_season_modifiers.destroy.failed') %>">
              <button type="button" class="btn btn-sm btn-danger" data-action="score-modifier-attachment#detach">
                <%= t('.detach') %>
              </button>
              <div data-score-modifier-attachment-target="error" class="text-danger small mt-1" hidden></div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('.no_attachments') %></p>
<% end %>
