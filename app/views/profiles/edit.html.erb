<h2 class="mb-3"><%= t('.title') %></h2>

<p><%= t('.explanation') %></p>

<div class="border-3 border border-light rounded-2 shadow p-3">
  <%= simple_form_for @user, url: profile_path, method: :patch do |f| %>
    <%= render "devise/shared/error_messages", resource: @user %>

    <%= f.input :country, collection: country_options, label_method: :first, value_method: :last,
                include_blank: true %>
    <%= f.input :date_of_birth, as: :date, start_year: Date.current.year - 100, end_year: Date.current.year,
                include_blank: true %>

    <%= f.button :submit, class: "btn btn-success" %>
  <% end %>
</div>
